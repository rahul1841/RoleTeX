# RoleTeX — example environment configuration.
# Copy to .env and fill in real values. NEVER commit a real .env (rule M-4).
# Numeric knobs are clamped server-side to the documented bounds (rule C-5).

# --- Mode & database -------------------------------------------------------
# MongoDB connection string. Unset/empty -> the app boots in single-user
# "demo mode" (no accounts, seed-resume tailoring only).
# Local docker-compose value: mongodb://localhost:27017
MONGODB_URI=
# Database name inside the Mongo deployment.
MONGODB_DB=jd_resume_builder

# --- Secrets ----------------------------------------------------------------
# Long random string. Derives the Fernet key that encrypts user API keys at
# rest. Unset -> a random ephemeral key is generated at boot (health reports
# checks.secret_key: "ephemeral") and stored keys become unreadable after a
# restart. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- Sessions & cookies ------------------------------------------------------
# Session lifetime in days (bounds 1-90).
SESSION_TTL_DAYS=30
# Secure flag on the session cookie: auto | true | false.
# auto -> Secure whenever the request scheme / X-Forwarded-Proto is https.
COOKIE_SECURE=auto

# --- Account policy ----------------------------------------------------------
# Allow new account registration (true/false).
ALLOW_REGISTRATION=true
# In multi-user mode, let users WITHOUT a stored key fall back to the
# operator's server-side env provider keys (true/false). Off by default.
ALLOW_ENV_KEY_FALLBACK=false
# Refuse every feature route until a user confirms their email address
# (true/false). They can still read /api/me, manage sessions, and request a new
# verification mail while blocked. Off by default.
REQUIRE_EMAIL_VERIFICATION=false

# --- Account email (password reset, address verification) ----------------------
# Public origin of this deployment, e.g. https://roletex.example. One-time links
# in outbound mail are built from it. REQUIRED once SMTP_HOST is set: without it
# the link origin would have to come from the request's Host header, which lets
# an attacker point a victim's real reset token at their own domain. Only
# http:// and https:// values are accepted; anything else is treated as unset.
PUBLIC_BASE_URL=
# Envelope sender for account mail.
MAIL_FROM=roletex@localhost
# SMTP server. Leave SMTP_HOST empty to use the console driver, which logs the
# message (link included) instead of sending it — fine for local development,
# never for a deployment real users can reach.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Issue STARTTLS after connecting (true/false).
SMTP_STARTTLS=true
# Socket timeout for one send, seconds (bounds 5-120).
SMTP_TIMEOUT_SECONDS=15
# One-time link lifetimes.
# Password reset, minutes (bounds 5-1440).
PASSWORD_RESET_TTL_MINUTES=60
# Email verification, hours (bounds 1-168).
EMAIL_VERIFY_TTL_HOURS=48

# --- Proxy trust ----------------------------------------------------------------
# Behind a reverse proxy (Hugging Face Spaces, nginx, a load balancer) the socket
# peer is the proxy for EVERY visitor, so all callers collapse into one rate-limit
# bucket and the login throttle degenerates to per-email lockout. Turn this on to
# key those limits on X-Forwarded-For instead.
# Only enable it when a proxy you control overwrites the header — otherwise any
# client forges a fresh bucket per request.
TRUST_PROXY_HEADERS=false
# Number of proxies in front of the app; the client address is read this many
# entries from the right of X-Forwarded-For (bounds 1-10).
TRUSTED_PROXY_HOPS=1

# --- Rate limits --------------------------------------------------------------
# LLM-cost bucket: tailor, resume import, run recompile.
# Calls per window (bounds 1-1000) / window seconds (bounds 10-3600).
RATE_LIMIT_LLM_CALLS=10
RATE_LIMIT_LLM_WINDOW_SECONDS=300
# Per-IP ceiling on those same routes, over the same window (bounds 1-5000).
# The per-user bucket resets with every new account, so it caps politeness; this
# caps cost. Deliberately looser so a shared egress is not throttled to one
# user's budget.
RATE_LIMIT_LLM_IP_CALLS=30
# General bucket: all other authenticated API calls.
# Calls per window (bounds 10-10000) / window seconds (bounds 1-3600).
RATE_LIMIT_GENERAL_CALLS=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
# Failed-login throttle per email+IP.
# Attempts (bounds 1-100) / window seconds (bounds 10-3600).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# Mail bucket: password-reset and verification requests. Charged twice per
# call — once against the caller's IP and once against the target address — so
# neither spraying many addresses nor bombing one can outrun it.
# Calls per window (bounds 1-100) / window seconds (bounds 60-86400).
RATE_LIMIT_EMAIL_CALLS=5
RATE_LIMIT_EMAIL_WINDOW_SECONDS=900

# --- Per-user quotas -----------------------------------------------------------
MAX_RESUMES_PER_USER=10          # bounds 1-100
MAX_VERSIONS_PER_RESUME=20       # bounds 1-100
MAX_JDS_PER_USER=50              # bounds 1-500
MAX_VERSIONS_PER_JD=20           # bounds 1-100 (archived history per JD; oldest pruned)
MAX_RUNS_PER_USER=200            # bounds 10-2000; oldest runs are pruned

# --- PDF import -----------------------------------------------------------------
# Upload cap in bytes (bounds 1MB-20MB).
MAX_PDF_UPLOAD_BYTES=10000000
# poppler pdftotext binary (name on PATH or absolute path).
PDFTOTEXT_BIN=pdftotext
# Extraction subprocess timeout in seconds (bounds 10-120).
PDF_EXTRACT_TIMEOUT_SECONDS=30

# --- LLM (existing knobs; see README for the full table) --------------------------
# Operator default provider. "mock" is deterministic and offline.
LLM_PROVIDER=mock
# Server-side operator keys (used in demo mode, and in multi-user mode only
# when ALLOW_ENV_KEY_FALLBACK=true). Users add their own keys in Settings.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# LLM_MODEL=
