# Copy to .env and fill in. Never commit a real .env.
# Keep comments on their own line: an inline comment after an empty value is read as the value.

# --- Database ---
# Required: the server will not start without it.
MONGODB_URI=
MONGODB_DB=jd_resume_builder

# --- Secret ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- Sessions ---
SESSION_TTL_DAYS=30
# auto | true | false
COOKIE_SECURE=auto

# --- Accounts ---
ALLOW_REGISTRATION=true
ALLOW_ENV_KEY_FALLBACK=false
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (sign-up codes, password reset) ---
# Empty SMTP_HOST = codes and links are printed in the server log instead of sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=16-char App Password.
PUBLIC_BASE_URL=
MAIL_FROM=roletex@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_HOURS=48

# --- Proxy ---
# true only behind a proxy you control.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# --- Rate limits ---
RATE_LIMIT_LLM_CALLS=10
RATE_LIMIT_LLM_WINDOW_SECONDS=300
RATE_LIMIT_LLM_IP_CALLS=30
RATE_LIMIT_GENERAL_CALLS=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_EMAIL_CALLS=5
RATE_LIMIT_EMAIL_WINDOW_SECONDS=900

# --- Per-user quotas ---
MAX_RESUMES_PER_USER=10
MAX_VERSIONS_PER_RESUME=20
MAX_JDS_PER_USER=50
MAX_VERSIONS_PER_JD=20
MAX_RUNS_PER_USER=200

# --- PDF import ---
MAX_PDF_UPLOAD_BYTES=5000000
MAX_IMPORT_PDF_PAGES=3
PDFTOTEXT_BIN=pdftotext
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
PDF_EXTRACT_TIMEOUT_SECONDS=30

# --- LLM (optional server-side defaults; users add their own keys in Settings) ---
# Providers: groq, cerebras, gemini, openrouter, mistral, openai, anthropic, grid, custom
# LLM_PROVIDER=
# LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GRID_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# GRID_BASE_URL=https://your-gateway.example.com/v1
# GRID_MODEL=
# GRID_VISION=true
